import tokenize

NAME = "py-ast"
VERSION = "0.2.0"  # 0.2.0: package nodes carry the module docstring
SKETCH = 64
M64 = (1 << 64) - 1
STDLIB = set(getattr(sys, "stdlib_module_names", ()))
SKIP_DIRS = {".git", ".venv", "venv", "node_modules", "__pycache__", ".mypy_cache",
             ".ruff_cache", ".pytest_cache", "build", "dist", ".eggs", "site-packages"}
DEFAULT_CONFIG = {
