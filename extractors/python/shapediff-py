#!/usr/bin/env python3
"""shapediff Python extractor under the plug-in contract of spec 6.3.

Invoked as  shapediff-py --repo <dir> --config <path>  and writes one schema
v1 graph document to stdout. Syntactic (``ast``), stdlib only, no imports
executed. Resolution is by import binding, so every edge it emits is
``resolved`` except calls through a function value (``dynamic``); nothing is
name-matched. The extractor declares ``precision: inferred`` because it has
no type checker behind it.

What it maps (Python shape on the Go-shaped schema):
  package     one per module file; the import path is the file path without
              ``.py`` (``backend/app/routers/pipelines``), ``__init__`` stripped;
              ``doc`` is the module docstring's first sentence
  symbol      top-level def -> func, class -> type, method -> ``Class.m``
              (method), module assignment -> var (UPPER_CASE -> const)
  entrypoint  FastAPI ``@router.<verb>("/path")`` -> ``entry:http:VERB
              <router prefix><path>``; ``@mcp.tool()`` / ``@mcp.resource(uri)``
              -> ``entry:cli:...``
  sink        SQLAlchemy session calls -> ``sink:db:<__tablename__>`` when the
              statement names exactly one mapped class (source ``table``),
              else ``sink:db:sqlalchemy`` (source ``package``); httpx /
              requests / aiohttp calls -> ``sink:http_client:<module>``
  edges       imports (package -> package, third-party collapsed to one node
              per distribution, stdlib not drawn), calls (import-bound, plus
              ``self.m()`` and a function passed as a value: dynamic,
              targets 1), handles, reads / writes, implements (class ->
              internal base)
"""

import argparse
import ast
import fnmatch
import hashlib
import io
import json
import os
import re
import subprocess
