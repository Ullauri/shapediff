    "build_tags": [],
    "ignore": ["**/mocks/**", "**/testdata/**"],
    "entrypoints": {},
    "sinks": {},
    "budget": {"chars": 1800, "nodes": 24, "edges": 36},
    "narrow_targets": 2,
    "narration": "template",
    "llm": {"endpoint": "", "model": "", "api_key_env": "SHAPEDIFF_LLM_KEY"},
}
HTTP_VERBS = {"get", "post", "put", "patch", "delete", "head", "options"}
DB_READS = {"execute", "scalars", "scalar", "scalar_one", "scalar_one_or_none", "get",
            "get_one", "stream", "stream_scalars", "exec"}
DB_WRITES = {"add", "add_all", "delete", "merge", "bulk_save_objects"}
DB_RECEIVER = re.compile(r"(^|\.)(db|session|_db|_session|sess)$")
SQL_WRITE_FUNCS = {"update", "delete", "insert"}
HTTP_LIBS = {"httpx", "requests", "aiohttp", "urllib3"}
READ_VERBS = ("get", "list", "find", "fetch", "load", "read", "select", "count", "exists", "query", "search", "has")
